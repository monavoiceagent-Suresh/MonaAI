// Source of truth for the application database. Runs on any PostgreSQL 14+:
// local Docker today, the future Supabase project later (only DATABASE_URL changes).
//
// Tenancy is enforced in the application layer (see src/lib/workspace.ts): every
// query on a tenant table is scoped by a client id resolved from the caller's
// client_members row. Identity is an opaque user id from the auth provider, so
// there are no foreign keys into auth-provider schemas.
//
// Status-like columns are text with CHECK constraints (see prisma/migrations),
// because the UI works with the human-readable display strings directly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Local accounts. Passwords are stored as salted scrypt hashes; sessions are opaque random
// tokens stored only as SHA-256 hashes, so a database leak does not yield usable sessions.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  fullName     String   @default("") @map("full_name") @db.VarChar(100)
  passwordHash String   @map("password_hash")
  // Platform-wide owner access (Super Admin), separate from any workspace's client_members role.
  // At most one row can have this set (see the partial unique index in the migration).
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships ClientMember[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Every sign-in attempt, used to slow down password guessing per email address.
model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt])
  @@map("login_attempts")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  status        String   @default("active")
  creditBalance Int      @default(0) @map("credit_balance")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members        ClientMember[]
  campaigns      Campaign[]
  leads          Lead[]
  prompts        Prompt[]
  calls          Call[]
  creditLedger   CreditTransaction[]
  voiceJobs      VoiceEngineJob[]
  inboundNumbers InboundNumber[]
  phoneNumbers   PhoneNumber[]
  outcomeSettings CallOutcomeSettings?
  providerSettings VoiceProviderSettings?

  @@map("clients")
}

model ClientMember {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @default("member")
  invitedEmail String   @default("") @map("invited_email")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([userId])
  @@map("client_members")
}

model CreditTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  amount    Int
  note      String   @default("")
  createdBy String?  @map("created_by") @db.Uuid
  // Set by the Super Admin console on every manual adjustment; a retried request reusing the
  // same key cannot insert a second row. Historical rows (and any future automated debits)
  // have none.
  idempotencyKey String?  @unique @map("idempotency_key")
  // MANUAL_ADJUSTMENT (super-admin-credits.functions.ts) or VOICE_USAGE (voice-engine/webhook.ts)
  // for every row written from here on; UNKNOWN for everything written before this column
  // existed — never guessed from the note text (see the migration).
  type           String   @default("UNKNOWN")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("credit_transactions")
}

// One global credit price, applied to future adjustments only (see
// src/lib/super-admin-credits.functions.ts). Always exactly one row, at the fixed id the
// application reads/writes (CREDIT_PRICING_ROW_ID); historical CreditTransaction rows are
// never touched by a price change.
model CreditPricing {
  id              String   @id @db.Uuid
  pricePerCredit  Decimal  @default(1) @map("price_per_credit") @db.Decimal(10, 4)
  updatedBy       String?  @map("updated_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("credit_pricing")
}

model Campaign {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @map("client_id") @db.Uuid
  name               String   @db.VarChar(100)
  purpose            String   @default("")
  status             String   @default("Scheduled")
  personaKey         String   @default("") @map("persona_key")
  voice              String   @default("")
  // The real provider voice (GET /voices on the engine); empty means none chosen yet, so the agent keeps
  // whatever voice it already has. voice itself stays the display name shown in the UI.
  voiceId            String   @default("") @map("voice_id")
  voiceModelId       String   @default("") @map("voice_model_id")
  ambience           Boolean  @default(false)
  callingStart       String   @default("09:00") @map("calling_start") @db.VarChar(5)
  callingEnd         String   @default("18:00") @map("calling_end") @db.VarChar(5)
  maxTries           Int      @default(3) @map("max_tries")
  retryGapMinutes    Int      @default(30) @map("retry_gap_minutes")
  callbackWindowDays Int      @default(3) @map("callback_window_days")
  creditCap          Int?     @map("credit_cap")
  scheduledAt        DateTime? @map("scheduled_at") @db.Timestamptz(6)
  // Overrides the tenant's own default outbound caller ID (PhoneNumber.isDefaultOutboundCallerId)
  // for this campaign's calls. Null means "use the tenant's current default", resolved fresh at
  // every dispatch (campaigns.functions.ts dispatchCampaign) — never cached here.
  callerIdPhoneNumberId String? @map("caller_id_phone_number_id") @db.Uuid
  createdBy          String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  callerIdPhoneNumber PhoneNumber? @relation(fields: [callerIdPhoneNumberId], references: [id], onDelete: SetNull)
  leads     Lead[]
  calls     Call[]
  voiceJobs VoiceEngineJob[]

  @@index([clientId, createdAt])
  @@map("campaigns")
}

model Lead {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  name       String    @default("—")
  phone      String    @db.VarChar(16)
  outcome    String    @default("Not called")
  queueState String    @default("Queued") @map("queue_state")
  attempts   Int       @default(0)
  followUpAt DateTime? @map("follow_up_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  calls    Call[]

  @@unique([campaignId, phone])
  @@index([clientId])
  @@map("leads")
}

model Prompt {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  personaKey     String   @map("persona_key") @db.VarChar(40)
  name           String   @db.VarChar(100)
  purpose        String   @default("")
  active         Boolean  @default(true)
  language       String   @default("English")
  instructions   String   @default("")
  knowledge      String   @default("")
  greeting       String   @default("")
  currentVersion Int      @default(1) @map("current_version")
  // This persona's own ASR/TTS provider choice (agent/app/config.py ASRProvider/TTSProvider), ahead of the
  // workspace's VoiceProviderSettings and the engine's own global default. Null at every level means the
  // engine's global default, exactly as before these columns existed.
  asrProvider         String?  @map("asr_provider")
  asrFallbackProvider String?  @map("asr_fallback_provider")
  ttsProvider         String?  @map("tts_provider")
  ttsFallbackProvider String?  @map("tts_fallback_provider")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  versions PromptVersion[]

  @@unique([clientId, personaKey])
  @@map("prompts")
}

// Immutable snapshots: the application only inserts these, never updates or deletes.
model PromptVersion {
  id        String   @id @default(uuid()) @db.Uuid
  promptId  String   @map("prompt_id") @db.Uuid
  version   Int
  content   Json
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@map("prompt_versions")
}

// One finished call. Campaign calls and inbound calls share this table.
// `outcome` is Mona's normalized label (see src/lib/outcomes.ts); `outcomeRaw` keeps exactly what the
// engine reported. `clientId` always comes from Mona's own records (the campaign, or the inbound
// number mapping), never from the engine's message. `transcriptRef` is an opaque engine call id, not
// a link: the transcript is read server-side, per call, after a workspace check.
model Call {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  campaignId      String?   @map("campaign_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  jobId           String?   @map("job_id") @db.Uuid
  inboundNumberId String?   @map("inbound_number_id") @db.Uuid
  direction       String    @default("outbound")
  // Inbound: the caller. Outbound: not recorded by the engine.
  callerNumber    String?   @map("caller_number") @db.VarChar(20)
  // Inbound: our number that was dialled (E.164). Outbound: the contact's number.
  dialledNumber   String?   @map("dialled_number") @db.VarChar(20)
  status          String    @default("completed") @db.VarChar(40)
  outcome         String    @default("completed")
  outcomeRaw      String?   @map("outcome_raw") @db.VarChar(200)
  summary         String?
  collectedFields Json?     @map("collected_fields")
  durationSeconds Int       @default(0) @map("duration_seconds")
  transcriptUrl   String?   @map("transcript_url")
  transcriptRef   String?   @map("transcript_ref") @db.VarChar(40)
  engineCallId    String?   @unique @map("engine_call_id")
  // When the engine produced the event that last wrote this row; an older event never overwrites a newer one.
  reportedAt      DateTime? @map("reported_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  job           VoiceEngineJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  inboundNumber InboundNumber?  @relation(fields: [inboundNumberId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([clientId, direction, createdAt(sort: Desc)])
  @@index([clientId, outcome])
  @@index([campaignId])
  @@map("calls")
}

// One dispatch of a campaign to the external voice engine. The partial unique index
// "at most one open job per campaign" is added in a hand-written migration because Prisma cannot
// express partial indexes. "Open" is pending/dispatched/running, or failed with an engine_job_id: the
// engine accepted that one even though saving it here failed, so it may still be dialling
// (campaigns.functions.ts dispatchCampaign/stopCampaignDispatch).
model VoiceEngineJob {
  creditStopPending Boolean @default(false) @map("credit_stop_pending")
  id             String    @id @default(uuid()) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  idempotencyKey String    @unique @default(uuid()) @map("idempotency_key") @db.Uuid
  status         String    @default("pending")
  // The prompt version the campaign was started with (the engine speaks that copy).
  personaVersion Int?      @map("persona_version")
  engineJobId    String?   @unique @map("engine_job_id")
  lastError      String?   @map("last_error")
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  client   Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   VoiceEngineWebhookEvent[]
  calls    Call[]

  @@index([campaignId])
  @@map("voice_engine_jobs")
}

// Every webhook delivery, keyed by the engine's event id, so retries and replays
// are rejected before they can double-count a call or usage.
model VoiceEngineWebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique @map("event_id")
  jobId      String?  @map("job_id") @db.Uuid
  eventType  String   @map("event_type")
  payload    Json
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  job VoiceEngineJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("voice_engine_webhook_events")
}

// A dialled number answered by one persona. This row is the DRAFT edited on the Inbound screen; calls
// follow only what was last published to the engine (the newest `synced` InboundPublication).
// The phone is globally unique: one number can never route for two workspaces.
model InboundNumber {
  id                 String   @id @default(uuid()) @db.Uuid
  clientId           String   @map("client_id") @db.Uuid
  phone              String   @unique @db.VarChar(16)
  personaKey         String   @map("persona_key") @db.VarChar(40)
  workflow           String   @default("general")
  active             Boolean  @default(true)
  // Highest version the engine reported holding, so a publish never goes out below it.
  knownEngineVersion Int      @default(0) @map("known_engine_version")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  publications InboundPublication[]
  calls        Call[]

  @@index([clientId])
  @@map("inbound_numbers")
}

// One attempt to publish a number's route. `snapshot` is exactly what was sent to the engine, so a
// rollback re-sends an earlier snapshot rather than rebuilding it from today's persona.
model InboundPublication {
  id             String    @id @default(uuid()) @db.Uuid
  numberId       String    @map("number_id") @db.Uuid
  version        Int
  status         String    @default("pending")
  snapshot       Json
  personaVersion Int       @map("persona_version")
  error          String?
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz(6)

  number InboundNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@unique([numberId, version])
  @@map("inbound_publications")
}

// Central inventory of Exotel numbers the account holds, independent of any inbound route
// (M1: see docs/MULTI_TENANT_TELEPHONY_PLAN.md). A number here may or may not also have an
// InboundNumber row; owning/assigning a number (this table) and routing inbound calls on it
// (InboundNumber/InboundPublication) are deliberately separate concerns (locked decision: phone
// numbers and concurrent channels — and, within numbers, ownership and inbound routing — are
// independent resources, never conflated in one row).
model PhoneNumber {
  id                        String   @id @default(uuid()) @db.Uuid
  e164                      String   @unique @db.VarChar(16)
  exotelNumberSid           String?  @unique @map("exotel_number_sid")
  // VOICE_IN | VOICE_OUT | VOICE_BOTH: what this number may be used for.
  capability                String   @default("VOICE_BOTH") @map("capability")
  // UNASSIGNED | ASSIGNED | SUSPENDED | RELEASED | DISABLED (see PhoneNumberAssignmentEvent.action
  // for the lifecycle transitions between these; enforced in src/lib/phone-numbers.functions.ts,
  // not by a DB CHECK, so an operational note can be added without a migration).
  status                    String   @default("UNASSIGNED") @map("status")
  clientId                  String?  @map("client_id") @db.Uuid
  // At most one number per tenant has this set (enforced in phone-numbers.functions.ts, not a DB
  // constraint): the number dispatchCampaign resolves when a campaign has no callerIdPhoneNumberId
  // override of its own.
  isDefaultOutboundCallerId Boolean  @default(false) @map("is_default_outbound_caller_id")
  acquiredAt                DateTime? @map("acquired_at") @db.Timestamptz(6)
  monthlyCostPaisa          Int?     @map("monthly_cost_paisa")
  notes                     String?  @default("")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client      Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  events      PhoneNumberAssignmentEvent[]
  campaigns   Campaign[]

  @@index([clientId])
  @@index([status])
  @@map("phone_numbers")
}

// Append-only audit trail of every assignment-lifecycle transition (locked decision: record every
// transition; invalidate stale selections for future dispatches — enforced by dispatchCampaign
// re-resolving and re-validating the caller ID at every dispatch, never trusting a cached value).
model PhoneNumberAssignmentEvent {
  id                String   @id @default(uuid()) @db.Uuid
  phoneNumberId     String   @map("phone_number_id") @db.Uuid
  clientId          String?  @map("client_id") @db.Uuid
  // ASSIGNED | UNASSIGNED | SUSPENDED | REACTIVATED | SET_DEFAULT_OUTBOUND | STATUS_CHANGED
  action            String
  performedByUserId String?  @map("performed_by_user_id") @db.Uuid
  // Caller-supplied; a retried request with the same key is treated as the same transition, never
  // a second one (the same idempotency pattern as CreditTransaction.idempotencyKey).
  idempotencyKey    String?  @unique @map("idempotency_key")
  reason            String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId, createdAt])
  @@map("phone_number_assignment_events")
}

// One workspace's own Call Outcome Rules: what each named conversation outcome means, the always-last
// "Inconclusive" fallback definition, and the short-hangup threshold. One row per client, saved whole.
// Sent with every campaign dispatch and test call as the persona's outcome_rules/outcome_fallback
// (agent/app/models.py); empty enabled rules means the engine's own fixed per-workflow list is used,
// exactly as before this table existed, so an untouched workspace stays backward-compatible.
model CallOutcomeSettings {
  id                          String   @id @default(uuid()) @db.Uuid
  clientId                    String   @unique @map("client_id") @db.Uuid
  // OutcomeRule[] (src/lib/call-outcome-rules.ts): {id, name, definition, enabled, builtIn}, in priority order.
  rules                       Json     @default("[]")
  fallback                    String   @default("")
  shortHangupThresholdSeconds Int      @default(15) @map("short_hangup_threshold_seconds")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("call_outcome_settings")
}

// One workspace's own ASR/TTS provider choice: the "Workspace" tier of the engine's Persona -> Workspace ->
// Global precedence (agent/app/config.py ASRProvider/TTSProvider). One row per client; a brand-new workspace
// has none, which means every field falls through to the Persona's own choice or, failing that, the engine's
// global default — exactly as before this table existed.
model VoiceProviderSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  clientId            String   @unique @map("client_id") @db.Uuid
  asrProvider         String?  @map("asr_provider")
  asrFallbackProvider String?  @map("asr_fallback_provider")
  ttsProvider         String?  @map("tts_provider")
  ttsFallbackProvider String?  @map("tts_fallback_provider")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("voice_provider_settings")
}

// A cached copy of one voice's sample clip from the engine's `GET /voices/preview`, so the
// campaign wizard's Preview button only pays for TTS synthesis once per voice. Keyed by voiceId
// alone (not per-tenant): the sample is the same for every workspace, since the engine always
// previews the same fixed line for a given voice.
model VoicePreviewCache {
  voiceId     String   @id @map("voice_id")
  contentType String   @map("content_type")
  audio       Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("voice_preview_cache")
}

// Generic mutex for a one-off/ops server route that must never run two instances
// concurrently (e.g. the tenant→engine backfill at /api/admin/tenant-backfill). Not a job
// queue: callers acquire by inserting (or reclaiming an expired) row for their own `key`,
// and release by deleting it. The expiry is a self-healing fallback if a run crashes
// mid-batch — holding the lock across an entire resumable run would otherwise deadlock it.
model OpsLock {
  key        String   @id
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("ops_locks")
}

model DemoRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(20)
  company   String   @default("") @db.VarChar(120)
  message   String   @default("") @db.VarChar(600)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("demo_requests")
}
